# Copy to .env for local development. Values here match docker-compose.yml.

# Postgres
DATABASE_URL="postgresql://roadcase:roadcase@localhost:5432/roadcase"

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="roadcase"
S3_ACCESS_KEY_ID="roadcase"
S3_SECRET_ACCESS_KEY="roadcase-dev-secret"
S3_FORCE_PATH_STYLE="true"

# Seed: first admin account (password is hashed with argon2, never logged)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_DISPLAY_NAME="Administrator"

# Email: Mailpit in development (http://localhost:8025). Production uses Resend:
# EMAIL_PROVIDER="resend" and RESEND_API_KEY (see docs/DEPLOY.md).
EMAIL_PROVIDER="mailpit"
MAILPIT_URL="http://localhost:8025"
EMAIL_FROM_ADDRESS="no-reply@roadcase.localhost"

# Links in email and Slack point here.
APP_URL="http://localhost:3000"

# The organization's time zone: decides when a check-out becomes overdue (the
# day after it's due) and when reminders go out. Defaults to US Eastern.
APP_TIME_ZONE="America/New_York"

# Encrypts secrets stored in the database (Slack webhook URLs). 32 random bytes,
# base64: run `openssl rand -base64 32`. Changing it makes saved webhooks unreadable.
SECRETS_ENCRYPTION_KEY=""

# Auth.js: generate a secret with `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Organization used for sign-in when the address has no matching subdomain.
# Optional while there is only one organization.
# DEFAULT_ORGANIZATION_SLUG=""

# Public base URL for branding images (in MinIO the branding/ prefix is
# public-read). Leave it unset in production: Roadcase then serves branding
# images itself from /branding/..., so the whole bucket can stay private.
S3_PUBLIC_BASE_URL="http://localhost:9000/roadcase"
